{
  // The Help&I internet relay. It stores and forwards end-to-end encrypted messages for a group
  // and never sees what they say. Free tier: one Durable Object (SQLite) per group.
  "name": "helprelayandeye",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "GROUPS", "class_name": "Group" },
      { "name": "METER", "class_name": "Meter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Group", "Meter"] }],
  // REQUIRE_PASS "1" turns away any request for a group without a pass issued by Help&I
  // (relay/pass.mjs), so groups use this relay only while Help&I is paid for it. ISSUER_KEY is the
  // issuer's public key, from `node pass.mjs public`; it is public, so a var, not a secret. Off by
  // default, so a relay deployed before passes keeps taking every group.
  "vars": { "REQUIRE_PASS": "0", "ISSUER_KEY": "" },
  // Requests a minute: failed signature checks per address (a signed request is never limited by
  // address, as phones on one care home's Wi-Fi share one), signed requests per key (a call's post
  // never), reads per group (256 members, phone and watch, polling twice a minute while a call is
  // open, up to 5 pages: 5,120), and new groups per address.
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "KEY_LIMIT", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "GROUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 6000, "period": 60 } },
    { "name": "REGISTER_LIMIT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ]
}
